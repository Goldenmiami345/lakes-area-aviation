# Set these in Vercel: Project Settings > Environment Variables. Never commit real values.
# Resend API key for the training-plan form (https://resend.com/api-keys).
RESEND_API_KEY=
# Where leads are delivered. Defaults to golden@golden.miami.
LEAD_TO=
# Sender address on a domain verified in Resend, e.g. "Lakes Area Aviation <plans@lakesareaaviation.com>".
LEAD_FROM=
