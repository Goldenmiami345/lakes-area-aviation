---
// Inner-page opening: title and one sentence, optionally over a photo.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { kicker?: string; title: string; text?: string; image?: ImageMetadata; imageAlt?: string; focus?: string }
const { kicker, title, text, image, imageAlt = '', focus } = Astro.props;
---
{image ? (
  <header class="ph photo on-ink">
    <Picture src={image} alt={imageAlt} widths={[640, 960, 1440, 1920, 2560].filter((w) => w <= image.width)} sizes="100vw" formats={['webp']} fallbackFormat="webp" quality={74} loading="eager" fetchpriority="high" class="ph-img" style={focus ? `object-position:${focus}` : undefined} />
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="wrap ph-copy">
      {kicker && <p class="ph-kicker">{kicker}</p>}
      <h1>{title}</h1>
      {text && <p class="ph-text">{text}</p>}
      <slot />
    </div>
  </header>
) : (
  <header class="ph plain">
    <div class="wrap ph-copy">
      {kicker && <p class="ph-kicker">{kicker}</p>}
      <h1>{title}</h1>
      {text && <p class="ph-text">{text}</p>}
      <slot />
    </div>
  </header>
)}

<style>
  .ph { position: relative; }
  .ph h1 { font-size: var(--step-5); max-width: 16ch; }
  .ph-kicker { font-weight: 600; margin-bottom: 1rem; }
  .ph-text { margin-top: 1.25rem; font-size: var(--step-1); line-height: 1.5; max-width: 44ch; }
  .plain { padding: calc(var(--nav-h) + clamp(3rem, 2rem + 5vw, 7rem)) 0 clamp(2.5rem, 2rem + 3vw, 4.5rem); border-bottom: 1px solid var(--rule); }
  .plain .ph-kicker { color: var(--blue-text); }
  .plain .ph-text { color: var(--text-2); }
  .photo { min-height: min(78svh, 46rem); display: flex; align-items: flex-end; overflow: hidden; }
  .photo :global(.ph-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,22,38,.55) 0%, rgba(12,22,38,.15) 28%, rgba(12,22,38,.7) 58%, rgba(12,22,38,.92) 100%); }
  .photo .ph-copy { position: relative; text-shadow: 0 1px 12px rgba(12,22,38,.6); padding-top: calc(var(--nav-h) + 4rem); padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .photo .ph-kicker { color: var(--radar); }
  .photo .ph-text { color: var(--on-ink-2); }
</style>
