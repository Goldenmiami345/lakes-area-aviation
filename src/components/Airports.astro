---
import { SITE } from '../data/site';
interface Props { heading?: string; withPlan?: boolean }
const { heading = 'Three airports', withPlan = false } = Astro.props;
const maps = (l: (typeof SITE.locations)[number]) => `https://maps.apple.com/?q=${encodeURIComponent(`${l.airport}, ${l.street}, ${l.city}, ${l.state} ${l.zip}`)}`;
---
<section class="airports section" aria-labelledby="ap-h">
  <div class="wrap">
    <h2 id="ap-h" class="ap-h">{heading}</h2>
    <ul class="ap-list">
      {SITE.locations.map((l) => (
        <li class="ap">
          <p class="ap-code num">{l.code}</p>
          <div>
            <h3>{l.city}, {l.stateName}</h3>
            <p class="ap-name">{l.airport}</p>
            <address><a href={maps(l)} rel="noopener" target="_blank">{l.street}, {l.city}, {l.state} {l.zip}<span class="sr-only"> (opens Maps)</span></a></address>
          </div>
          {withPlan && <a class="link ap-plan" href={`/contact?location=${l.code}`}>Plan training at {l.city}</a>}
        </li>
      ))}
    </ul>
    <p class="ap-phone">One phone line for all three: <a class="link num" href={SITE.phoneHref}>{SITE.phone}</a></p>
  </div>
</section>
<style>
  .ap-h { font-size: var(--step-3); margin-bottom: 2rem; }
  .ap-list { list-style: none; border-top: 1px solid var(--rule); }
  .ap { display: grid; grid-template-columns: 4.5rem 1fr; gap: .5rem 1.25rem; padding-block: 1.5rem; border-bottom: 1px solid var(--rule); align-items: start; }
  @media (min-width: 900px) { .ap { grid-template-columns: 7rem 1fr auto; align-items: center; } }
  .ap-code { font: 700 var(--step-1)/1.2 var(--font-ui); color: var(--blue-text); }
  .ap h3 { font-size: var(--step-2); }
  .ap-name { color: var(--text-2); margin-top: .25rem; }
  address { font-style: normal; }
  address a { display: inline-flex; min-height: 44px; align-items: center; color: var(--text-2); text-underline-offset: .2em; }
  .ap-plan { grid-column: 2; display: inline-flex; min-height: 44px; align-items: center; }
  @media (min-width: 900px) { .ap-plan { grid-column: auto; } }
  .ap-phone { margin-top: 1.5rem; color: var(--text-2); }
  .ap-phone a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
