---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="About" description="Lakes Area Aviation provides flight instruction, pilot services, aircraft management and specialized training in Minnesota, Colorado and Arizona.">
  <PageHead kicker="About" title="A practical place to become a better pilot." text="Flight instruction, pilot services, aircraft management and specialized training, from bases in Minnesota, Colorado and Arizona." />
  <section class="section">
    <div class="wrap about">
      <p class="big">Lakes Area Aviation was founded to provide high-quality, safe aviation services and instruction, and to keep them affordable for anyone with a passion for flying.</p>
      <div class="vision">
        <h2>Build a community of aviators</h2>
        <p>That is the school’s vision: reach the community through education and inspire the next generation of pilots.</p>
        <a class="link" href="/team">Meet the instructors</a>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .about { display: grid; gap: 3.5rem; }
  @media (min-width: 1000px) { .about { grid-template-columns: 1.4fr 1fr; gap: 6rem; align-items: start; } }
  .big { font: 400 var(--step-3)/1.3 var(--font-display); max-width: 30ch; }
  .vision { display: grid; gap: 1rem; justify-items: start; padding-top: 1.5rem; border-top: 2px solid var(--blue); }
  .vision h2 { font-size: var(--step-2); }
  .vision p { color: var(--text-2); }
  .vision .link { display: inline-flex; min-height: 44px; align-items: center; }
</style>
