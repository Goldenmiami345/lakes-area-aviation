---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { SPECIALIZED } from '../data/site';
---
<Base title="Specialized training" description="Kodiak 100 initial and recurrent training with insurance-approved instruction, plus tailwheel, complex, high-performance, high-altitude and spin endorsements.">
  <PageHead kicker="Specialized training" title="Beyond the ratings." text="Endorsements, the Kodiak 100, and courses you won’t find at most schools." />
  <section class="section">
    <div class="wrap spec">
      <div class="kodiak">
        <h2>Kodiak 100</h2>
        <p>An approved initial and recurrent training provider with most insurance companies.</p>
        <dl class="facts num">
          <div><dt>Initial</dt><dd>{SPECIALIZED.kodiak.initial}</dd></div>
          <div><dt>Recurrent</dt><dd>{SPECIALIZED.kodiak.recurrent}</dd></div>
        </dl>
      </div>
      <div>
        <h2>Endorsements</h2>
        <ul class="list">{SPECIALIZED.endorsements.map((e) => <li>{e}</li>)}</ul>
      </div>
      <div>
        <h2>Courses</h2>
        <ul class="list two">{SPECIALIZED.courses.map((c) => <li><span>{c.name}</span><span class="where">{c.where}</span></li>)}</ul>
      </div>
    </div>
    <div class="wrap"><p class="ask">Pricing and timelines depend on the course and your experience. <a class="link" href="/contact?goal=specialized">Ask in your training plan</a>.</p></div>
  </section>
  <CtaBand />
</Base>
<style>
  .spec { display: grid; gap: 3.5rem; }
  @media (min-width: 1000px) { .spec { grid-template-columns: 1.2fr 1fr 1fr; gap: 4rem; } }
  h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .kodiak p { color: var(--text-2); max-width: 36ch; }
  .facts { display: flex; gap: 2.5rem; margin-top: 2rem; }
  .facts dt { color: var(--text-2); font-size: var(--step--1); font-weight: 600; }
  .facts dd { margin: .25rem 0 0; font: 500 var(--step-2)/1.1 var(--font-display); }
  .list { list-style: none; border-top: 1px solid var(--rule); }
  .list li { padding: .9rem 0; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; gap: 1rem; }
  .where { color: var(--text-2); font-size: var(--step--1); align-self: center; }
  .ask { margin-top: 3rem; color: var(--text-2); }
</style>
