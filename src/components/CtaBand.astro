---
import { SITE } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Plan your next rating.', text = 'Tell us what you hold and where you want to be. We’ll build the days, the aircraft and the cost around you.' } = Astro.props;
---
<section class="cta on-ink" aria-labelledby="cta-h">
  <div class="wrap cta-grid">
    <div>
      <h2 id="cta-h">{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/contact">Build my training plan</a>
      <a class="btn btn-ghost light" href={SITE.phoneHref}>Call <span class="num">{SITE.phone}</span></a>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: clamp(4rem, 3rem + 5vw, 7.5rem); border-bottom: 1px solid rgba(255,255,255,.1); }
  .cta-grid { display: grid; gap: 2rem; align-items: end; }
  @media (min-width: 900px) { .cta-grid { grid-template-columns: 1.4fr 1fr; } .cta-actions { justify-content: flex-end; } }
  .cta h2 { font-size: var(--step-4); margin-bottom: 1rem; max-width: 14ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
</style>
