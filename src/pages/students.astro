---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Airports from '../components/Airports.astro';
import CtaBand from '../components/CtaBand.astro';
import { FSP_SIGNUP, SITE } from '../data/site';
---
<Base title="Students" description="Start training with Lakes Area Aviation or get access to scheduling and training resources as a current student.">
  <PageHead kicker="Students" title="Start here, new or returning." />
  <section class="section">
    <div class="wrap two">
      <div class="col">
        <h2>New students</h2>
        <ol class="steps">
          <li>Talk with us about your goals and dates: call <a class="link num" href={SITE.phoneHref}>{SITE.phone}</a> or build a training plan.</li>
          <li>Create your Flight Schedule Pro account. Scheduling and billing all happen there.</li>
        </ol>
        <div class="acts">
          <a class="btn btn-primary" href="/contact">Build my training plan</a>
          <a class="btn btn-ghost" href={FSP_SIGNUP} target="_blank" rel="noopener">Sign up for scheduling<span class="sr-only"> (opens Flight Schedule Pro)</span></a>
        </div>
        <p class="more"><a class="link" href="/new-students">What to expect on day one</a></p>
      </div>
      <div class="col">
        <h2>Current students</h2>
        <p class="body">Need access to training resources, or have a question about your schedule? Send us a note and tell us what you need.</p>
        <div class="acts"><a class="btn btn-ghost" href="/contact?topic=resources">Request resource access</a></div>
      </div>
    </div>
  </section>
  <Airports />
  <CtaBand />
</Base>
<style>
  .two { display: grid; gap: 4rem; }
  @media (min-width: 900px) { .two { grid-template-columns: 1fr 1fr; gap: 6rem; } }
  h2 { font-size: var(--step-3); }
  .steps { margin: 1.5rem 0 0 1.25rem; display: grid; gap: 1rem; }
  .steps li { padding-left: .5rem; }
  .steps a { display: inline; }
  .body { margin-top: 1.5rem; color: var(--text-2); max-width: 44ch; }
  .acts { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .more { margin-top: 1.5rem; }
  .more a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
