---
// Live traffic layer drawn in the aerial image's own pixel space (1500 × 1500), so it stays locked
// to the photo under object-fit: cover. The phone aerials extend the same imagery; their viewBox
// covers the wider area at the same scale.
import { FIELDS, type FieldId } from '../lib/fields';
interface Props { field: FieldId; hasPhoneImage: boolean }
const { field, hasPhoneImage } = Astro.props;
const f = FIELDS[field];
---
<svg class="traffic" viewBox="0 0 1500 1500" preserveAspectRatio="xMidYMid slice" data-field={field}
  data-phone-view={hasPhoneImage ? '265 -300 970 2100' : undefined} role="img"
  aria-label={`Simulated traffic pattern at ${f.name}, following live wind`}>
  <path class="pattern" data-pattern d="" />
  <g data-planes></g>
</svg>

<style>
  .traffic { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .pattern { fill: none; stroke: var(--radar); stroke-width: 2; stroke-dasharray: 1 7; stroke-linecap: round; opacity: .8; vector-effect: non-scaling-stroke; }
  :global(.traffic .ac) { transition: opacity .6s; }
  :global(.traffic .ring) { fill: none; stroke: var(--radar); stroke-width: 1.4; vector-effect: non-scaling-stroke; opacity: .9; }
  :global(.traffic .body) { fill: #f4f2ec; stroke: rgba(12,22,38,.55); stroke-width: .6; }
  :global(.traffic .shadow) { fill: rgba(0,0,0,.38); }
  :global(.traffic .tag) { font-family: var(--font-ui); font-weight: 700; fill: var(--radar); paint-order: stroke; stroke: rgba(12,22,38,.85); stroke-width: 5px; stroke-linejoin: round; }
  :global(.traffic .tag tspan.sub) { font-weight: 600; fill: #e7f6ee; }
</style>
