---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PROGRAMS, itemsTotal, type Program } from '../../data/programs';
import { PHOTOS, type PhotoKey } from '../../data/photos';
import { usd } from '../../data/site';

export function getStaticPaths() {
  return PROGRAMS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Program };
const photo = PHOTOS[p.photo as PhotoKey] ?? PHOTOS.commercial;
const lead = p.courses[0]!;
const idx = PROGRAMS.findIndex((x) => x.slug === p.slug);
const next = PROGRAMS[idx + 1];
const desc = `${p.name} at Lakes Area Aviation: ${lead.timeline.toLowerCase()}, published estimate ${p.slug === 'zero-to-hero' ? 'about' : 'as low as'} ${usd(lead.asLowAs)}. Every line item, prerequisite and note.`;
const wantId: Record<string, string> = { 'private-pilot': 'ppl', 'instrument-rating': 'ir', 'commercial-single-engine': 'csel', 'commercial-multi-engine': 'cmel', 'cfi-cfii': 'cfi', mei: 'mei' };
---
<Base title={p.name} description={desc} overlay image={photo.src.src}>
  <PageHead kicker={p.outcome} title={p.name} text={p.summary} image={photo.src} imageAlt={photo.alt}>
    <dl class="key num">
      <div><dt>Timeline</dt><dd>{lead.timeline}</dd></div>
      <div><dt>{p.slug === 'zero-to-hero' ? 'Approximately' : 'As low as'}</dt><dd>{usd(lead.asLowAs)}</dd></div>
      <div><dt>Aircraft</dt><dd>{p.aircraft}</dd></div>
    </dl>
  </PageHead>

  {p.steps && (
    <section class="section steps-s">
      <div class="wrap">
        <h2 class="h">The path, in order</h2>
        <ol class="steps">
          {p.steps.map((s, i) => <li><span class="i num">{i + 1}</span><div><h3>{s.name}</h3><p>{s.text}</p></div><p class="c num">{s.cost}</p></li>)}
        </ol>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap courses">
      {p.courses.map((c) => (
        <article class="course">
          <header class="ch"><h2>{c.name}</h2><p class="tl num">{c.timeline}</p></header>
          <div class="cg">
            <div>
              <h3 class="sub">What it costs</h3>
              <table class="sheet">
                <caption class="sr-only">{c.name}: cost breakdown</caption>
                <tbody>
                  {c.items.map((i) => (
                    <tr>
                      <th scope="row">{i.label}{i.hours !== undefined && <span class="calc num">{i.hours} hr × ${i.rate}</span>}</th>
                      <td class="num">{i.note ?? usd(i.amount)}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot><tr><th scope="row">{p.slug === 'zero-to-hero' ? 'Published estimate, about' : 'Published estimate, as low as'}</th><td class="num">{usd(c.asLowAs)}</td></tr></tfoot>
              </table>
            </div>
            <div>
              <h3 class="sub">Before you start</h3>
              <ul class="reqs">{c.requirements.map((r) => <li>{r}</li>)}</ul>
            </div>
          </div>
        </article>
      ))}
      <ul class="notes">{p.notes.map((n) => <li>{n}</li>)}</ul>
      <div class="acts">
        <a class="btn btn-primary" href={wantId[p.slug] ? `/contact?want=${wantId[p.slug]}` : '/contact'}>Plan my {p.slug === 'zero-to-hero' ? 'path' : p.name}</a>
        <a class="btn btn-ghost" href="/rates">See all rates</a>
      </div>
    </div>
  </section>

  {next && (
    <nav class="next on-ink" aria-label="Next program">
      <a class="wrap next-in" href={`/programs/${next.slug}`}><span class="k">Next rating</span><span class="t">{next.name}</span><span class="o">{next.outcome}</span></a>
    </nav>
  )}
  <CtaBand />
</Base>
<style>
  .key { display: flex; flex-wrap: wrap; gap: 1.25rem 2.75rem; margin-top: 2rem; }
  .key dt { font-size: var(--step--1); font-weight: 600; color: var(--on-ink-2); }
  .key dd { margin: .25rem 0 0; font: 500 var(--step-2)/1.15 var(--font-display); }
  .h { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .steps { list-style: none; border-top: 1px solid var(--rule); }
  .steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: .25rem 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 800px) { .steps li { grid-template-columns: 3rem 1fr auto; align-items: baseline; } }
  .i { font: 500 var(--step-2)/1 var(--font-display); color: var(--blue-text); }
  .steps h3 { font-size: var(--step-2); }
  .steps p { color: var(--text-2); max-width: 56ch; margin-top: .3rem; }
  .c { grid-column: 2; font-weight: 700; color: var(--text) !important; }
  @media (min-width: 800px) { .c { grid-column: 3; } }
  .courses { display: grid; gap: 4rem; }
  .ch { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem 2rem; padding-bottom: 1rem; border-bottom: 2px solid var(--text); }
  .ch h2 { font-size: var(--step-3); }
  .tl { font-weight: 700; color: var(--blue-text); }
  .cg { display: grid; gap: 2.5rem; margin-top: 2rem; }
  @media (min-width: 1000px) { .cg { grid-template-columns: 1.5fr 1fr; gap: 4rem; } }
  .sub { font: 600 var(--step-0)/1.3 var(--font-ui); color: var(--text-2); margin-bottom: .5rem; }
  .sheet { width: 100%; border-collapse: collapse; }
  .sheet th, .sheet td { padding: .85rem 0; border-bottom: 1px solid var(--rule); text-align: left; font-weight: 500; vertical-align: baseline; }
  .sheet td { text-align: right; padding-left: 1rem; white-space: nowrap; }
  .calc { display: block; color: var(--text-2); font-size: var(--step--1); font-weight: 500; margin-top: .1rem; }
  .sheet tfoot th, .sheet tfoot td { font-weight: 700; border-bottom: 0; padding-top: 1.1rem; }
  .sheet tfoot td { font: 500 var(--step-2)/1 var(--font-display); }
  .reqs { list-style: none; display: grid; gap: .9rem; }
  .reqs li { padding-left: 1.4rem; position: relative; }
  .reqs li::before { content: ''; position: absolute; left: 0; top: .55em; width: .55rem; height: .55rem; border: 2px solid var(--blue); border-radius: 50%; }
  .notes { list-style: none; display: grid; gap: .5rem; color: var(--text-2); font-size: var(--step--1); max-width: 70ch; }
  .acts { display: flex; flex-wrap: wrap; gap: .75rem; }
  .next-in { display: grid; gap: .25rem; padding-block: 2.5rem; text-decoration: none; }
  .next .k { color: var(--on-ink-2); font-weight: 600; font-size: var(--step--1); }
  .next .t { font: 500 var(--step-4)/1.05 var(--font-display); }
  .next .o { color: var(--on-ink-2); }
  .next-in:hover .t { color: var(--blue-on-ink); }
</style>
